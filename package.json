{
  "name": "tsumazuki-branch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && npm run bundle:api",
    "bundle:api": "esbuild server/vercel-entry.ts --bundle --platform=node --format=esm --target=node22 --outfile=api/analyze.js",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "eval": "tsx eval/run.ts",
    "verify:ui": "tsx scripts/verify-ui.ts",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "format": "prettier --write src server tests scripts eval/*.ts vite.config.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vite": "^6.4.0",
    "vitest": "3.2.4"
  }
}
